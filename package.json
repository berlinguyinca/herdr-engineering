{
  "name": "herdr-engineering",
  "version": "0.1.0",
  "private": true,
  "description": "HerdR Dev Fabric control plane and engineering workspace",
  "type": "module",
  "scripts": {
    "test": "node --test --test-concurrency=1 packages/herdr-web-client/*.test.js packages/herdr-web-components/*.test.js tests/playwright/*.test.mjs",
    "test:ui": "node --test --test-concurrency=1 tests/playwright/*.test.mjs",
    "test:client": "node --test packages/herdr-web-client/*.test.js packages/herdr-web-components/*.test.js",
    "test:ui-gates": "node --test --test-concurrency=1 tests/playwright/ui-gates-*.test.mjs tests/visual/*.test.mjs",
    "ui-gates:baselines:update": "node tests/playwright/visual-baselines.mjs update",
    "ui-gates:baselines:check": "node tests/playwright/visual-baselines.mjs check"
  },
  "devDependencies": {
    "playwright": "^1.64.0"
  }
}
