{
  "name": "herdr-engineering",
  "version": "0.1.0",
  "private": true,
  "description": "HerdR Dev Fabric control plane and engineering workspace",
  "type": "module",
  "scripts": {
    "test": "node --test --test-concurrency=1 packages/herdr-web-client/*.test.js packages/herdr-web-components/*.test.js packages/*.test.js 'tests/playwright/!(ui-gates-)*.test.mjs'",
    "test:ui": "node --test --test-concurrency=1 'tests/playwright/!(ui-gates-)*.test.mjs'",
    "test:annotations": "node --test --test-concurrency=1 tests/playwright/annotate-view.test.mjs tests/playwright/artifact-feedback.test.mjs tests/playwright/artifact-reports.test.mjs tests/playwright/share-annotations.test.mjs tests/playwright/live-mime.test.mjs",
    "test:client": "node --test packages/herdr-web-client/*.test.js packages/herdr-web-components/*.test.js packages/*.test.js",
    "test:ui-gates": "node --test --test-concurrency=1 tests/playwright/ui-gates-*.test.mjs tests/visual/*.test.mjs",
    "ui-gates:baselines:update": "node tests/playwright/visual-baselines.mjs update",
    "ui-gates:baselines:check": "node tests/playwright/visual-baselines.mjs check",
    "typecheck:pi-build-gate": "tsc -p deploy/pi-build-gate/tsconfig.json"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.5.0",
    "@types/node": "26.6.6",
    "c8": "10.1.3",
    "eslint": "10.15.0",
    "playwright": "^1.64.0",
    "prettier": "3.10.1",
    "typescript": "7.0.2"
  }
}
