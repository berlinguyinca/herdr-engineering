#!/usr/bin/env python3
"""Delete dead Woodpecker agent registrations.

Dead means a system agent (owner_id=-1) that either never contacted the server
and is older than --never-contacted-secs (default 1h), or has had no contact
and no work for --stale-secs (default 24h). An agent that any pending or
running workflow in the queue references is never touched, and the server
itself refuses to delete an agent with a running task. Dry run unless --apply.
Guards (abort, nothing deleted, exit 3): candidates over 50% of scanned system
agents, or no system agent has contacted the server in --recent-contact-mins
(default 60; the server just came back). At most --max-deletions (default 50)
are deleted per run. Missing owner/org fields make an agent ineligible.
The API token is read from a file and is never printed.
"""
import argparse
import json
import stat
import sys
import time
import urllib.error
import urllib.request
from pathlib import Path

PAGE = 50


def call(server, token, method, path):
    req = urllib.request.Request(server.rstrip("/") + path, method=method,
                                 headers={"Authorization": "Bearer " + token})
    with urllib.request.urlopen(req, timeout=30) as resp:
        body = resp.read()
    return json.loads(body) if body.strip() else None


def list_agents(server, token):
    agents, page = [], 1
    while True:
        rows = call(server, token, "GET", f"/api/agents?perPage={PAGE}&page={page}")
        agents += rows
        if len(rows) < PAGE:
            return agents
        page += 1


def busy_ids(server, token):
    queue = call(server, token, "GET", "/api/queue/info")
    tasks = (queue.get("pending") or []) + (queue.get("running") or []) + (queue.get("waiting_on_deps") or [])
    return {t["agent_id"] for t in tasks if t.get("agent_id", 0) > 0}


def verdict(agent, now, busy, never_secs, stale_secs):
    """Return a delete reason, or None to keep the agent. Fails safe on missing fields."""
    if agent.get("id") in busy:
        return None
    if agent.get("owner_id") != -1 or agent.get("org_id") != -1:
        return None
    last_contact, created = agent.get("last_contact"), agent.get("created")
    if not isinstance(last_contact, (int, float)) or not isinstance(created, (int, float)):
        return None
    if last_contact == 0:
        return "never-contacted" if now - created > never_secs else None
    newest = max(last_contact, agent.get("last_work") or 0)
    return "stale" if now - newest > stale_secs else None


def is_system(agent):
    return agent.get("owner_id") == -1 and agent.get("org_id") == -1


def abort(msg):
    print("abort: " + msg + "; nothing deleted", file=sys.stderr)
    return 3


def main(argv):
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--server", default="https://ci.metabolomics.us")
    ap.add_argument("--token-file", default=str(Path.home() / ".config/woodpecker/token"))
    ap.add_argument("--never-contacted-secs", type=int, default=3600)
    ap.add_argument("--stale-secs", type=int, default=86400)
    ap.add_argument("--max-deletions", type=int, default=50)
    ap.add_argument("--recent-contact-mins", type=int, default=60)
    ap.add_argument("--apply", action="store_true")
    args = ap.parse_args(argv)
    token_path = Path(args.token_file)
    if token_path.stat().st_mode & (stat.S_IRWXG | stat.S_IRWXO):
        print(f"refusing: {token_path} must be mode 0600 (chmod 600 it)", file=sys.stderr)
        return 2
    token = token_path.read_text().strip()
    try:
        return run(args, token)
    except (urllib.error.URLError, OSError, ValueError) as exc:
        print(f"abort: API error ({type(exc).__name__}: {exc}); run stopped", file=sys.stderr)
        return 1


def run(args, token):
    now = time.time()
    agents = list_agents(args.server, token)
    busy = busy_ids(args.server, token)
    system = [a for a in agents if is_system(a)]
    cands = []
    for a in sorted(agents, key=lambda a: a.get("id", 0)):
        reason = verdict(a, now, busy, args.never_contacted_secs, args.stale_secs)
        if reason:
            cands.append((a, reason))
    if cands:
        horizon = now - args.recent_contact_mins * 60
        if not any((a.get("last_contact") or 0) > horizon for a in system):
            return abort(f"no agent has contacted the server in the last {args.recent_contact_mins} minutes")
        if len(cands) * 2 > len(system):
            return abort(f"{len(cands)} candidates exceed 50% of {len(system)} system agents")
    removed = skipped = 0
    kept = len(agents) - len(cands)
    for agent, reason in cands[:args.max_deletions]:
        label = f"agent_id={agent['id']} name={agent.get('name') or '-'} reason={reason}"
        if not args.apply:
            print("would-remove " + label)
            removed += 1
            continue
        # Fresh queue check right before each delete.
        if agent["id"] in busy_ids(args.server, token):
            kept += 1
            continue
        try:
            call(args.server, token, "DELETE", f"/api/agents/{agent['id']}")
        except urllib.error.HTTPError as exc:
            if exc.code != 409:
                raise
            print("skipped (409 conflict) " + label)
            skipped += 1
            continue
        print("removed " + label)
        removed += 1
    deferred = max(len(cands) - args.max_deletions, 0)
    print(f"summary scanned={len(agents)} removed={removed} skipped={skipped} kept={kept} "
          f"deferred={deferred} mode={'apply' if args.apply else 'dry-run'}")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
