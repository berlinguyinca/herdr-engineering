[Unit]
Description=HerdR terminal relay (Shepherd terminal, outbound only)
# No After=network-online.target: a user unit cannot be ordered against system units. The relay retries with
# backoff until the network is up, so ordering is not needed. It needs the user's session (see README: linger).

[Service]
Type=simple
ExecStart=%h/.local/bin/herdr-eng host terminal-relay
Restart=always
RestartSec=3
# Exit 2: host.json is missing or the token was revoked; restarting cannot fix that.
RestartPreventExitStatus=2
# Only directives that work in a user unit without user namespaces. PrivateTmp, ProtectSystem and the like need
# namespaces (unprivileged user namespaces are off on some hosts) and would stop the unit from starting.
NoNewPrivileges=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=yes

[Install]
WantedBy=default.target
