[Unit]
Description=HerdR terminal relay (Shepherd terminal, outbound only)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment="PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin"
ExecStart=%h/.local/bin/herdr-eng host terminal-relay
Restart=always
RestartSec=3
# Exit 2: host.json is missing or the token was revoked; restarting cannot fix that.
RestartPreventExitStatus=2
NoNewPrivileges=yes
PrivateTmp=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=yes

[Install]
WantedBy=default.target
