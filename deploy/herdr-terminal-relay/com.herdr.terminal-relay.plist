<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.herdr.terminal-relay</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>-c</string>
    <string>exec "$HOME/.local/bin/herdr-eng" host terminal-relay</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <!-- launchd cannot be told not to restart on exit status 2 (host.json missing, token revoked), so it may only
       restart every 30 s: a relay that cannot work stays quiet instead of spinning. -->
  <key>ThrottleInterval</key>
  <integer>30</integer>
  <!-- launchd does not expand ~ or $HOME here: replace USER with the account name when installing. -->
  <key>StandardErrorPath</key>
  <string>/Users/USER/Library/Logs/herdr-terminal-relay.log</string>
</dict>
</plist>
