# System unit: append the assistant audit head to the anchor file (`herdr-eng control-plane assistant-audit anchor`).
# Run every 15 minutes by herdr-audit-anchor.timer. Not installed or enabled by anything; see
# docs/operations/lineage-continuity-runbook.md ("Anchor timer") for the install steps, and the REPLACE markers below.
#
# What it needs, and nothing more:
#   * a dedicated, login-less user `herdr-anchor` (useradd --system --shell /usr/sbin/nologin herdr-anchor);
#   * /var/lib/herdr-anchor (0700, owned by herdr-anchor): the ONLY writable path. The anchor file lives there; put that
#     directory on a different device than the event store, and mark the file append-only once (chattr +a, see the runbook);
#   * /etc/herdr/anchor/approver.key (0400, owned by herdr-anchor): an API key of a configured approver of the tenant;
#   * /etc/herdr/anchor/fleet-config.yaml (0600, owned by herdr-anchor): a MINIMAL fleet file whose only content is
#     control_plane.personal_assistant.audit.anchor_file = /var/lib/herdr-anchor/assistant-audit.anchor
#     (never the central file: it carries database credentials this user must not read).
# No Environment= / EnvironmentFile=: everything comes from the two files above and the command line.
[Unit]
Description=Anchor the assistant audit head off the event store
Documentation=file:///usr/share/doc/herdr-engineering/lineage-continuity-runbook.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=herdr-anchor
Group=herdr-anchor
UMask=0077
Restart=no
TimeoutStartSec=2min
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/herdr-anchor
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6
CapabilityBoundingSet=
# REPLACE the control-plane URL with the real one (host.json is per-user, and this user has no home).
ExecStart=/usr/local/bin/herdr-eng control-plane assistant-audit anchor --fleet-config /etc/herdr/anchor/fleet-config.yaml --control-plane https://REPLACE-control-plane.example.invalid --api-key-file /etc/herdr/anchor/approver.key
