# Example .env for the control-plane compose stack.
# Do NOT use these values — run ./generate-env.sh to create a real .env with
# randomly generated strong credentials. This file documents every variable.

# Postgres
HERDR_CP_PG_USER=herdr_4f9c2a1b
HERDR_CP_PG_PASSWORD=<generate-a-strong-random-password>

# MinIO (S3 drop-in for RustFS)
HERDR_CP_MINIO_USER=herdr_8d3b7c0e
HERDR_CP_MINIO_PASSWORD=<generate-a-strong-random-password>

# Which host interface the control-plane web UI is published on.
#   127.0.0.1    = loopback only (default, safe)
#   <tailnet-ip> = reachable on dev.lan (Tailnet is the trust boundary;
#                  all machines belong to each other and are WireGuard-encrypted)
HERDR_CP_WEB_BIND=127.0.0.1
