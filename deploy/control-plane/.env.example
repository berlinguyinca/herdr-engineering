# Example .env for the control-plane compose stack.
# Do NOT use these values — run ./generate-env.sh to create a real .env with
# randomly generated strong credentials. This file documents every variable.

# Postgres
HERDR_CP_PG_USER=herdr_4f9c2a1b
HERDR_CP_PG_PASSWORD=<generate-a-strong-random-password>

# MinIO (S3 drop-in for RustFS)
HERDR_CP_MINIO_USER=herdr_8d3b7c0e
HERDR_CP_MINIO_PASSWORD=<generate-a-strong-random-password>

# Which host interface the control-plane web UI is published on.
#   127.0.0.1    = loopback only (default, safe)
#   <tailnet-ip> = reachable on dev.lan (Tailnet is the trust boundary;
#                  all machines belong to each other and are WireGuard-encrypted)
HERDR_CP_WEB_BIND=127.0.0.1

# Host port the HerdR control-plane UI is served on (default 80 = http://dev.lan).
# The container keeps its internal 8080 listener; this is only the published port.
HERDR_CP_WEB_PUBLIC_PORT=80

# Loopback host port for the control-plane Postgres (default 5432). Change this
# only if another Postgres already owns 5432 on this host (the worker reaches
# Postgres over the bridge network regardless).
HERDR_CP_PG_PORT=5432

# Full DSN the control-plane web/worker use to reach Postgres over the compose
# bridge network (host = service name "postgres", db = herdr). Generated by
# ./generate-env.sh from the user/password above; the worker also derives it
# from HERDR_CP_PG_USER/PASSWORD if this is unset.
HERDR_CP_PG_DSN=postgresql://<user>:<password>@postgres:5432/herdr
