[Unit]
Description=HerdR native session and CI provenance snapshots
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/.local/share/herdr-cp-feed-plugin-current
Environment="PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin"
EnvironmentFile=-%h/.config/herdr-engineering/session-feed.env
ExecStart=/usr/bin/node %h/.local/share/herdr-cp-feed-plugin-current/snapshot.js --loop 30
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
