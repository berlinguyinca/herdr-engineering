# Example user unit (not installed by anything). It runs as the operator, whose `gh` login posts the status and
# whose codex login does the review: install it as a --user unit.
#   cp deploy/ci-review/herdr-ai-review.{service,timer} ~/.config/systemd/user/
#   systemctl --user daemon-reload && systemctl --user enable --now herdr-ai-review.timer
#   loginctl enable-linger "$USER"     # so the timer runs while you are logged out
[Unit]
Description=Independent AI review of open pull requests (posts the "Independent AI review" status)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 %h/IdeaProjects/herdr-engineering/deploy/ci-review/ai-review.py poll --config %h/.config/herdr-engineering/ai-review.yaml
TimeoutStartSec=3h
UMask=0077
# not PrivateTmp/ProtectHome: the sandbox needs ~/herdr-agents/work, the gh and codex logins, and a user scope
