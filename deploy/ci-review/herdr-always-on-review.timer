# Backup sweep only. The `Opus agent review` status is triggered per PR by .woodpecker/opus-review.yaml
# (docs/operations/per-pr-opus-review.md); this timer only catches heads whose webhook or pipeline was missed.
[Unit]
Description=Hourly backup sweep for pull request heads the per-PR Woodpecker review missed

[Timer]
OnBootSec=3min
OnUnitActiveSec=1h
RandomizedDelaySec=5min
Unit=herdr-always-on-review.service

[Install]
WantedBy=timers.target
