{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://herdr.dev/schemas/artifact-report-v1.schema.json",
  "title": "HerdR report descriptor v1",
  "$comment": "The runtime validator additionally enforces UTF-8 serialized size <=524288 bytes, JSON depth <=16, <=2000 total collection entries, unique collection IDs and asset names, valid cross references, and optional output-manifest binding. Schema validation does not verify findings or asset ownership.",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1,
      "type": "integer"
    },
    "title": {
      "type": "string",
      "maxLength": 16384
    },
    "summary": {
      "type": "string",
      "maxLength": 16384
    },
    "questions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/question"
      },
      "maxItems": 2000
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence"
      },
      "maxItems": 2000
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/finding"
      },
      "maxItems": 2000
    },
    "figures": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/figure"
      },
      "maxItems": 2000
    },
    "assets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/asset"
      },
      "maxItems": 2000
    },
    "analysis": {
      "$ref": "#/$defs/analysis"
    },
    "limitations": {
      "$ref": "#/$defs/strings"
    },
    "next_steps": {
      "$ref": "#/$defs/strings"
    }
  },
  "required": [
    "schema_version",
    "questions",
    "evidence",
    "findings",
    "figures",
    "assets"
  ],
  "additionalProperties": false,
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
      "maxLength": 128,
      "not": {
        "pattern": "[\\r\\n]"
      }
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16384,
      "pattern": "\\S"
    },
    "assetName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^(?!.*[:\\\\\\u0000-\\u001f\\u007f])(?!(?:\\.|\\.\\.)(?:/|$))(?!.*(?:/)(?:\\.|\\.\\.)(?:/|$))[^/]+(?:/[^/]+)*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "minLength": 64,
      "maxLength": 64
    },
    "references": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/id"
      },
      "uniqueItems": true,
      "maxItems": 2000
    },
    "strings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/text"
      },
      "maxItems": 2000
    },
    "jsonValue": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "number"
        },
        {
          "type": "string",
          "maxLength": 16384
        },
        {
          "type": "array",
          "maxItems": 2000,
          "items": {
            "$ref": "#/$defs/jsonValue"
          }
        },
        {
          "type": "object",
          "maxProperties": 2000,
          "propertyNames": {
            "maxLength": 256
          },
          "additionalProperties": {
            "$ref": "#/$defs/jsonValue"
          }
        }
      ]
    },
    "question": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "text": {
          "$ref": "#/$defs/text"
        }
      },
      "required": [
        "id",
        "text"
      ],
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "$ref": "#/$defs/text"
        },
        "description": {
          "$ref": "#/$defs/text"
        },
        "asset_ids": {
          "$ref": "#/$defs/references"
        }
      },
      "required": [
        "id",
        "title",
        "description"
      ],
      "additionalProperties": false
    },
    "finding": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "$ref": "#/$defs/text"
        },
        "statement": {
          "$ref": "#/$defs/text"
        },
        "question_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "uniqueItems": true,
          "maxItems": 2000,
          "minItems": 1
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "uniqueItems": true,
          "maxItems": 2000,
          "minItems": 1
        },
        "figure_ids": {
          "$ref": "#/$defs/references"
        },
        "limitations": {
          "$ref": "#/$defs/strings"
        },
        "next_steps": {
          "$ref": "#/$defs/strings"
        }
      },
      "required": [
        "id",
        "title",
        "statement",
        "question_ids",
        "evidence_ids"
      ],
      "additionalProperties": false
    },
    "figure": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "$ref": "#/$defs/text"
        },
        "asset_id": {
          "$ref": "#/$defs/id"
        },
        "caption": {
          "$ref": "#/$defs/text"
        },
        "reading_guide": {
          "$ref": "#/$defs/text"
        }
      },
      "required": [
        "id",
        "title",
        "asset_id",
        "caption"
      ],
      "additionalProperties": false
    },
    "asset": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "$ref": "#/$defs/assetName"
        },
        "role": {
          "enum": [
            "data",
            "source",
            "figure",
            "result",
            "preview"
          ]
        },
        "media_type": {
          "type": "string",
          "pattern": "^[A-Za-z0-9!#$&^_.+-]+/[A-Za-z0-9!#$&^_.+-]+$",
          "maxLength": 16384,
          "not": {
            "pattern": "[\\r\\n]"
          }
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        }
      },
      "required": [
        "id",
        "name",
        "role",
        "media_type",
        "sha256",
        "size_bytes"
      ],
      "additionalProperties": false
    },
    "analysis": {
      "type": "object",
      "properties": {
        "method": {
          "type": "string",
          "maxLength": 16384
        },
        "configuration": {
          "type": "object",
          "maxProperties": 2000,
          "propertyNames": {
            "maxLength": 256
          },
          "additionalProperties": {
            "$ref": "#/$defs/jsonValue"
          }
        },
        "code_revision": {
          "type": "string",
          "maxLength": 16384
        },
        "source_hashes": {
          "type": "object",
          "maxProperties": 2000,
          "propertyNames": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^(?!.*[:\\\\\\u0000-\\u001f\\u007f])(?!(?:\\.|\\.\\.)(?:/|$))(?!.*(?:/)(?:\\.|\\.\\.)(?:/|$))[^/]+(?:/[^/]+)*$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/sha256"
          }
        }
      },
      "required": [],
      "additionalProperties": false
    }
  }
}
