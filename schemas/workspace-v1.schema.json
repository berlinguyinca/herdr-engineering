        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "trace_id": {
          "$ref": "#/$defs/traceId"
        },
        "correlation_id": {
          "$ref": "#/$defs/traceId"
        },
        "causation_id": {
          "$ref": "#/$defs/traceId"
        },
        "actor": {
          "$ref": "#/$defs/actor"
        },
        "attributes": {
          "type": "object",
          "maxProperties": 32
        },
        "tombstone": {
          "$ref": "#/$defs/tombstone"
        }
      }
    }
  }
}
