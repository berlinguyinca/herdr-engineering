#!/usr/bin/env python3
# FAKE - test shim. NOT the GitHub CLI. It exists only because `autospec review-quorum verify-report` shells out to
# `gh pr view <n> --json headRefOid,url` (crates/autospec-cli/.../gate.rs live_pr) and there is no live GitHub in the
# acceptance suite. State is read from state.json NEXT TO THIS FILE (the test copies the shim into a private dir and
# writes the state there; no environment variable carries configuration). Every call is appended to calls.jsonl.
import json
import os
import sys

here = os.path.dirname(os.path.realpath(__file__))
args = sys.argv[1:]
with open(os.path.join(here, "calls.jsonl"), "a") as log:
    log.write(json.dumps(args) + "\n")
state = json.load(open(os.path.join(here, "state.json")))
if args[:2] == ["pr", "view"] and len(args) >= 3:
    pr = state.get("prs", {}).get(args[2])
    if pr is None:
        sys.stderr.write("no pull requests found (fake gh)\n")
        sys.exit(1)
    print(json.dumps({"headRefOid": pr["head"], "url": pr["url"]}))
    sys.exit(0)
sys.stderr.write("fake gh: unsupported command %r\n" % (args,))
sys.exit(2)
