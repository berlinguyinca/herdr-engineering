{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:herdr:event-intent:v1",
  "title": "Event request interpretation v1",
  "description": "Untrusted LLM-extracted data only. No identity, authority, model policy or derived guest total. Runtime checks source quotes, count sum, age ordering, supported currency and ambiguity. This schema is not permission to act.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "adults",
    "children",
    "childrenAgeRange",
    "budgetMinor",
    "currency",
    "separateBills",
    "separateBillPayers",
    "dateTime",
    "timezone",
    "clarifications",
    "evidence"
  ],
  "properties": {
    "adults": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "maximum": 100
    },
    "children": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "maximum": 100
    },
    "childrenAgeRange": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "minimum",
            "maximum"
          ],
          "properties": {
            "minimum": {
              "type": "integer",
              "minimum": 0,
              "maximum": 17
            },
            "maximum": {
              "type": "integer",
              "minimum": 0,
              "maximum": 17
            }
          }
        }
      ]
    },
    "budgetMinor": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "currency": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[A-Z]{3}$"
    },
    "separateBills": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "separateBillPayers": {
      "enum": [
        "adults",
        "everyone",
        null
      ]
    },
    "dateTime": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 200
    },
    "timezone": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 200
    },
    "clarifications": {
      "type": "array",
      "maxItems": 36,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "field",
          "reason"
        ],
        "properties": {
          "field": {
            "enum": [
              "adults",
              "children",
              "childrenAgeRange",
              "budgetMinor",
              "currency",
              "separateBills",
              "separateBillPayers",
              "dateTime",
              "timezone"
            ]
          },
          "reason": {
            "enum": [
              "missing",
              "ambiguous",
              "conflicting",
              "unsupported"
            ]
          }
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "adults",
        "children",
        "childrenAgeRange",
        "budgetMinor",
        "currency",
        "separateBills",
        "separateBillPayers",
        "dateTime",
        "timezone"
      ],
      "properties": {
        "adults": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 1000
        },
        "children": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 1000
        },
        "childrenAgeRange": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 1000
        },
        "budgetMinor": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 1000
        },
        "currency": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 1000
        },
        "separateBills": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 1000
        },
        "separateBillPayers": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 1000
        },
        "dateTime": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 1000
        },
        "timezone": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 1000
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "adults": {
            "type": "null"
          }
        }
      },
      "then": {
        "properties": {
          "evidence": {
            "properties": {
              "adults": {
                "type": "null"
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "evidence": {
            "properties": {
              "adults": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "children": {
            "type": "null"
          }
        }
      },
      "then": {
        "properties": {
          "evidence": {
            "properties": {
              "children": {
                "type": "null"
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "evidence": {
            "properties": {
              "children": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "childrenAgeRange": {
            "type": "null"
          }
        }
      },
      "then": {
        "properties": {
          "evidence": {
            "properties": {
              "childrenAgeRange": {
                "type": "null"
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "evidence": {
            "properties": {
              "childrenAgeRange": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "budgetMinor": {
            "type": "null"
          }
        }
      },
      "then": {
        "properties": {
          "evidence": {
            "properties": {
              "budgetMinor": {
                "type": "null"
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "evidence": {
            "properties": {
              "budgetMinor": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "currency": {
            "type": "null"
          }
        }
      },
      "then": {
        "properties": {
          "evidence": {
            "properties": {
              "currency": {
                "type": "null"
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "evidence": {
            "properties": {
              "currency": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "separateBills": {
            "type": "null"
          }
        }
      },
      "then": {
        "properties": {
          "evidence": {
            "properties": {
              "separateBills": {
                "type": "null"
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "evidence": {
            "properties": {
              "separateBills": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "separateBillPayers": {
            "type": "null"
          }
        }
      },
      "then": {
        "properties": {
          "evidence": {
            "properties": {
              "separateBillPayers": {
                "type": "null"
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "evidence": {
            "properties": {
              "separateBillPayers": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "dateTime": {
            "type": "null"
          }
        }
      },
      "then": {
        "properties": {
          "evidence": {
            "properties": {
              "dateTime": {
                "type": "null"
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "evidence": {
            "properties": {
              "dateTime": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "timezone": {
            "type": "null"
          }
        }
      },
      "then": {
        "properties": {
          "evidence": {
            "properties": {
              "timezone": {
                "type": "null"
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "evidence": {
            "properties": {
              "timezone": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "separateBills": {
            "enum": [
              false,
              null
            ]
          }
        }
      },
      "then": {
        "properties": {
          "separateBillPayers": {
            "type": "null"
          }
        }
      }
    }
  ]
}
