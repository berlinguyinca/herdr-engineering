#!/usr/bin/env bash
echo "docker $*" >> /Users/wohlgemuth/.local/share/worktrees/herdr-engineering-share-member-host/.tmp/pytest-of-wohlgemuth/pytest-0/test_the_certificate_must_name0/docker.log
# deploy-state.py asks for `inspect --type container NAME`: answer it like `inspect NAME`
if [ "$1 ${2:-} ${3:-}" = "inspect --type container" ] && [ "$#" = 4 ]; then set -- inspect "$4"; fi
is_missing() { case " $(cat /Users/wohlgemuth/.local/share/worktrees/herdr-engineering-share-member-host/.tmp/pytest-of-wohlgemuth/pytest-0/test_the_certificate_must_name0/missing 2>/dev/null) " in *" $1 "*) return 0 ;; esac; return 1; }
if [ "$1" = inspect ] && [ "${@: -1}" = "${STUB_INSPECT_ERROR:-}" ]; then
  echo "permission denied while trying to connect to the docker daemon" >&2; exit 1
fi
if [ "$1" = inspect ] && is_missing "${@: -1}"; then
  echo "Error: No such object: ${@: -1}" >&2; exit 1
fi
if [ "$1 $2" = 'image inspect' ]; then
  python3 - "$3" <<'PY'
import json, os, sys
old_id = 'sha256:' + 'a' * 64
old_tag = 'herdr-engineering:' + os.environ.get('STUB_PREVIOUS_TAG', '')
previous = sys.argv[1] in (old_id, old_tag)
identity = old_id if previous else 'sha256:' + 'b' * 64
if sys.argv[1] == old_tag:
    identity = os.environ.get('STUB_PREVIOUS_TAG_ID', identity)
commit = os.environ.get('STUB_PREVIOUS_COMMIT', '') if previous else '07f1b88cb8aa2ba1fd500c4e12f0babe5e10b0b9'
env = json.loads(os.environ['STUB_IMAGE_ENV']) if previous and 'STUB_IMAGE_ENV' in os.environ else ['HERDR_ENGINEERING_COMMIT=' + commit]
print(json.dumps([{'Id': identity, 'Config': {'Env': env}}]))
PY
  exit 0
fi
if [ "$1" = inspect ]; then
  if [ "$#" = 2 ]; then
    [ -n "${STUB_RUNNING_IMAGE:-}" ] || [ -s /Users/wohlgemuth/.local/share/worktrees/herdr-engineering-share-member-host/.tmp/pytest-of-wohlgemuth/pytest-0/test_the_certificate_must_name0/running-tag ] || exit 1
    python3 - "$2" <<'PY'
import json, os, pathlib, sys
mount = pathlib.Path('/Users/wohlgemuth/.local/share/worktrees/herdr-engineering-share-member-host/.tmp/pytest-of-wohlgemuth/pytest-0/test_the_certificate_must_name0/running-mount')
images = pathlib.Path('/Users/wohlgemuth/.local/share/worktrees/herdr-engineering-share-member-host/.tmp/pytest-of-wohlgemuth/pytest-0/test_the_certificate_must_name0/running-images.json')
ids = json.loads(images.read_text()) if images.exists() else {}
config = pathlib.Path('/Users/wohlgemuth/.local/share/worktrees/herdr-engineering-share-member-host/.tmp/pytest-of-wohlgemuth/pytest-0/test_the_certificate_must_name0/running-config-image')
print(json.dumps([{"Image": ids.get(sys.argv[1], "sha256:" + "a" * 64),
    "Config": {"Image": config.read_text() if config.exists() else os.environ.get("STUB_RUNNING_IMAGE", "herdr-engineering:test")},
    "Mounts": [{"Destination": "/etc/herdr/fleet", "Source": mount.read_text() if mount.exists() else os.environ["STUB_FLEET_DIR"]}]}]))
PY
    exit 0
  fi
  case "$*" in
    *.State*)   # container state: crash-looping when "<running tag>:<container>" is in STUB_CRASH
      name="${@: -1}"; tag="$(cat /Users/wohlgemuth/.local/share/worktrees/herdr-engineering-share-member-host/.tmp/pytest-of-wohlgemuth/pytest-0/test_the_certificate_must_name0/running-tag 2>/dev/null)"
      left="$(cat /Users/wohlgemuth/.local/share/worktrees/herdr-engineering-share-member-host/.tmp/pytest-of-wohlgemuth/pytest-0/test_the_certificate_must_name0/removing 2>/dev/null || echo 0)"
      if [ "$name" = herdr-collab-public ] && [ "$left" -gt 0 ]; then
        echo $((left - 1)) > /Users/wohlgemuth/.local/share/worktrees/herdr-engineering-share-member-host/.tmp/pytest-of-wohlgemuth/pytest-0/test_the_certificate_must_name0/removing; echo "removing false 0 none"; exit 0
      fi
      [ -n "$tag" ] || { echo "missing false 0 none"; exit 0; }
      case " ${STUB_CRASH:-} " in
        *" $tag:$name "*) echo "restarting true $(date +%s%N) none" ;;
        *) echo "running false 0 none" ;;
      esac
      exit 0 ;;
  esac
  if [ -f /Users/wohlgemuth/.local/share/worktrees/herdr-engineering-share-member-host/.tmp/pytest-of-wohlgemuth/pytest-0/test_the_certificate_must_name0/running-config-image ]; then cat /Users/wohlgemuth/.local/share/worktrees/herdr-engineering-share-member-host/.tmp/pytest-of-wohlgemuth/pytest-0/test_the_certificate_must_name0/running-config-image; exit 0; fi
  [ -n "${STUB_RUNNING_IMAGE:-}" ] || exit 1
  echo "$STUB_RUNNING_IMAGE"; exit 0
fi
if [ "$1" = build ] && [ -n "${FAIL_BUILD:-}" ]; then exit 1; fi
if [ "$1" = compose ]; then
  case " $* " in *"/deploy/artifact-host/compose.yaml "*)   # the artifact host's own project: logged, never the control plane's
    echo "$@" >> /Users/wohlgemuth/.local/share/worktrees/herdr-engineering-share-member-host/.tmp/pytest-of-wohlgemuth/pytest-0/test_the_certificate_must_name0/docker.log
    # STUB_FAIL_AH="<word>": a host-project call containing that word (e.g. migrate, pg_dump) fails
    [ -z "${STUB_FAIL_AH:-}" ] || case " $* " in *" $STUB_FAIL_AH "*) exit 1 ;; esac
    # the migrate service marks the schema as moved; a schema_migrations count query answers the value before / after it
    case " $* " in *" artifact-host-migrate "*) touch /Users/wohlgemuth/.local/share/worktrees/herdr-engineering-share-member-host/.tmp/pytest-of-wohlgemuth/pytest-0/test_the_certificate_must_name0/docker.log.migrated ;; esac
    case " $* " in *schema_migrations*)
      # STUB_AH_COUNT_FAIL=1: the count query fails (no output, non-zero), before and after the migration alike
      if [ -n "${STUB_AH_COUNT_FAIL:-}" ]; then exit 1; fi
      if [ -f /Users/wohlgemuth/.local/share/worktrees/herdr-engineering-share-member-host/.tmp/pytest-of-wohlgemuth/pytest-0/test_the_certificate_must_name0/docker.log.migrated ]; then echo "${STUB_AH_SCHEMA_AFTER:-3}"; else echo "${STUB_AH_SCHEMA_BEFORE:-3}"; fi ;; esac
    exit 0 ;; esac
  echo "composeenv fleetdir=${HERDR_CP_FLEET_DIR:-} tag=${HERDR_CP_IMAGE_TAG:-} collabdir=${HERDR_COLLAB_CONFIG_DIR:-} llmdir=${HERDR_LLM_SLICE_DIR:-} githubappdir=${HERDR_CP_GITHUB_APP_DIR:-}" >> /Users/wohlgemuth/.local/share/worktrees/herdr-engineering-share-member-host/.tmp/pytest-of-wohlgemuth/pytest-0/test_the_certificate_must_name0/docker.log
  if [ -n "${HERDR_LLM_SLICE_DIR:-}" ]; then echo "llmslice $(cat "$HERDR_LLM_SLICE_DIR/llm-config.json" | tr -d '
')" >> /Users/wohlgemuth/.local/share/worktrees/herdr-engineering-share-member-host/.tmp/pytest-of-wohlgemuth/pytest-0/test_the_certificate_must_name0/docker.log; fi
  prev=""; files=""; up=0; pins=""
  for a in "$@"; do
    if [ "$prev" = --env-file ]; then
      echo "envfile $a mode=$(stat -c %a "$a") dirmode=$(stat -c %a "$(dirname "$a")")" >> /Users/wohlgemuth/.local/share/worktrees/herdr-engineering-share-member-host/.tmp/pytest-of-wohlgemuth/pytest-0/test_the_certificate_must_name0/docker.log
      echo "webport tag=${HERDR_CP_IMAGE_TAG:-} $(grep '^HERDR_CP_WEB_PUBLIC_PORT=' "$a")" >> /Users/wohlgemuth/.local/share/worktrees/herdr-engineering-share-member-host/.tmp/pytest-of-wohlgemuth/pytest-0/test_the_certificate_must_name0/docker.log
    fi
    if [ "$prev" = -f ]; then
      files="$files $a"
      case "$a" in *rollback-images.json) pins="$a"; echo "pinned $(cat "$a")" >> /Users/wohlgemuth/.local/share/worktrees/herdr-engineering-share-member-host/.tmp/pytest-of-wohlgemuth/pytest-0/test_the_certificate_must_name0/docker.log ;; esac
    fi
    [ "$a" = up ] && up=1
    prev="$a"
  done
  echo "composefiles tag=${HERDR_CP_IMAGE_TAG:-}$files" >> /Users/wohlgemuth/.local/share/worktrees/herdr-engineering-share-member-host/.tmp/pytest-of-wohlgemuth/pytest-0/test_the_certificate_must_name0/docker.log
  if [ "$up" = 1 ]; then   # like compose: an up naming fabric-whois needs the overlay that defines it
    case " $* " in *" fabric-whois "*)
      case "$files" in *compose.collab-fabric.yaml*) ;; *)
        echo "no such service: fabric-whois" >&2; exit 1 ;; esac ;; esac
  fi
  lock="$HOME/.local/share/herdr-engineering/collab-sync.lock"
  if [ "$up" = 1 ] && [ -e "$lock" ]; then
    if flock -n "$lock" true; then echo "collablock free" >> /Users/wohlgemuth/.local/share/worktrees/herdr-engineering-share-member-host/.tmp/pytest-of-wohlgemuth/pytest-0/test_the_certificate_must_name0/docker.log; else echo "collablock held" >> /Users/wohlgemuth/.local/share/worktrees/herdr-engineering-share-member-host/.tmp/pytest-of-wohlgemuth/pytest-0/test_the_certificate_must_name0/docker.log; fi
  fi
  if [ "$up" = 1 ] && [ -n "${STUB_REMOVAL_IN_PROGRESS:-}" ]; then
    [ -e /Users/wohlgemuth/.local/share/worktrees/herdr-engineering-share-member-host/.tmp/pytest-of-wohlgemuth/pytest-0/test_the_certificate_must_name0/removal-left ] || echo "$STUB_REMOVAL_IN_PROGRESS" > /Users/wohlgemuth/.local/share/worktrees/herdr-engineering-share-member-host/.tmp/pytest-of-wohlgemuth/pytest-0/test_the_certificate_must_name0/removal-left
    n="$(cat /Users/wohlgemuth/.local/share/worktrees/herdr-engineering-share-member-host/.tmp/pytest-of-wohlgemuth/pytest-0/test_the_certificate_must_name0/removal-left)"
    if [ "$n" -gt 0 ]; then
      echo $((n - 1)) > /Users/wohlgemuth/.local/share/worktrees/herdr-engineering-share-member-host/.tmp/pytest-of-wohlgemuth/pytest-0/test_the_certificate_must_name0/removal-left; echo 1 > /Users/wohlgemuth/.local/share/worktrees/herdr-engineering-share-member-host/.tmp/pytest-of-wohlgemuth/pytest-0/test_the_certificate_must_name0/removing
      echo "removalinprogress" >> /Users/wohlgemuth/.local/share/worktrees/herdr-engineering-share-member-host/.tmp/pytest-of-wohlgemuth/pytest-0/test_the_certificate_must_name0/docker.log
      echo "Error response from daemon: removal of container herdr-collab-public is already in progress" >&2
      exit 1
    fi
  fi
  if [ "$up" = 1 ] && [ -n "${STUB_FAIL_REMOVES:-}" ]; then
    case " ${FAIL_COMPOSE_TAGS:-} " in *" ${HERDR_CP_IMAGE_TAG:-} "*)
      echo "${STUB_FAIL_REMOVES} $(cat /Users/wohlgemuth/.local/share/worktrees/herdr-engineering-share-member-host/.tmp/pytest-of-wohlgemuth/pytest-0/test_the_certificate_must_name0/missing 2>/dev/null)" > /Users/wohlgemuth/.local/share/worktrees/herdr-engineering-share-member-host/.tmp/pytest-of-wohlgemuth/pytest-0/test_the_certificate_must_name0/missing ;; esac
  fi
  if [ "$up" = 1 ]; then
    python3 - <<'PY' >> /Users/wohlgemuth/.local/share/worktrees/herdr-engineering-share-member-host/.tmp/pytest-of-wohlgemuth/pytest-0/test_the_certificate_must_name0/docker.log
import json, pathlib, os
state = pathlib.Path(os.environ['HOME']) / '.local/state/herdr-engineering/deploys'
attempts = list(state.glob('attempt-*/metadata.json'))
print('prepared_before_recreate', any(json.loads(p.read_text())['outcome'] == 'prepared' for p in attempts))
PY
    if [ -n "${FAIL_COMPOSE:-}" ]; then [ -z "${STUB_COMPOSE_STDERR:-}" ] || echo "$STUB_COMPOSE_STDERR" >&2; exit 1; fi
    case " ${FAIL_COMPOSE_TAGS:-} " in *" ${HERDR_CP_IMAGE_TAG:-} "*) exit 1 ;; esac
    echo "${HERDR_CP_IMAGE_TAG:-}" > /Users/wohlgemuth/.local/share/worktrees/herdr-engineering-share-member-host/.tmp/pytest-of-wohlgemuth/pytest-0/test_the_certificate_must_name0/running-tag
    if [ -e /Users/wohlgemuth/.local/share/worktrees/herdr-engineering-share-member-host/.tmp/pytest-of-wohlgemuth/pytest-0/test_the_certificate_must_name0/missing ]; then   # the services this up names exist again
      keep=""
      for m in $(cat /Users/wohlgemuth/.local/share/worktrees/herdr-engineering-share-member-host/.tmp/pytest-of-wohlgemuth/pytest-0/test_the_certificate_must_name0/missing); do
        svc="$(case "$m" in herdr-cp-web) echo control-plane-web ;; herdr-cp-worker) echo control-plane-worker ;;
          herdr-llm-proxy) echo llm-proxy ;; herdr-collab-public) echo collab-public ;; herdr-collab-edge) echo collab-edge ;;
          herdr-share-public) echo share-public ;; esac)"
        case " $* " in *" $svc "*) ;; *) keep="$keep $m" ;; esac
      done
      echo "$keep" > /Users/wohlgemuth/.local/share/worktrees/herdr-engineering-share-member-host/.tmp/pytest-of-wohlgemuth/pytest-0/test_the_certificate_must_name0/missing
    fi
    if [ -z "$pins" ] || [ -z "${STUB_IGNORE_ROLLBACK_MOUNT:-}" ]; then
      printf %s "$HERDR_CP_FLEET_DIR" > /Users/wohlgemuth/.local/share/worktrees/herdr-engineering-share-member-host/.tmp/pytest-of-wohlgemuth/pytest-0/test_the_certificate_must_name0/running-mount
    fi
    python3 - "$pins" <<'PY'
import json, os, pathlib, sys
names = {'control-plane-web':'herdr-cp-web', 'control-plane-worker':'herdr-cp-worker',
         'llm-proxy':'herdr-llm-proxy', 'collab-public':'herdr-collab-public', 'collab-edge':'herdr-collab-edge',
         'share-public':'herdr-share-public'}
ids = {v: 'sha256:' + 'b' * 64 for v in names.values()}
if sys.argv[1] and not os.environ.get('STUB_IGNORE_ROLLBACK_IMAGES'):
    ids.update({names[k]: v['image'] for k,v in json.loads(pathlib.Path(sys.argv[1]).read_text())['services'].items()})
pathlib.Path('/Users/wohlgemuth/.local/share/worktrees/herdr-engineering-share-member-host/.tmp/pytest-of-wohlgemuth/pytest-0/test_the_certificate_must_name0/running-images.json').write_text(json.dumps(ids))
pathlib.Path('/Users/wohlgemuth/.local/share/worktrees/herdr-engineering-share-member-host/.tmp/pytest-of-wohlgemuth/pytest-0/test_the_certificate_must_name0/running-config-image').write_text(ids['herdr-cp-web'] if sys.argv[1] else 'herdr-engineering:' + os.environ['HERDR_CP_IMAGE_TAG'])
PY
  fi
fi
exit 0
