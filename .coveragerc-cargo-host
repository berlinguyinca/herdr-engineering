[run]
branch = True
parallel = True
patch = subprocess,execv

[report]
include =
    */herdr_engineering/cargo_host.py
    */herdr_engineering/build_cache_location.py
    */herdr_engineering/cargo_target_storage.py
    */herdr_engineering/cargo_target_migration.py
    */herdr_engineering/cargo_target_retention.py
show_missing = True
# macOS-only code (diskutil / APFS volumes): the gate runs on Linux only, the macOS leg was dropped with GitHub Actions.
exclude_also =
    pragma: darwin-only
