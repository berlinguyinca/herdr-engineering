{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "allowJs": true,
    "checkJs": false,
    "skipLibCheck": true,
    "outDir": ".superpowers/communications-js",
    "rootDir": "packages",
    "noEmitOnError": true,
    "types": [],
    "lib": ["ES2022", "DOM"]
  },
  "include": ["packages/communications-view.ts"]
}
