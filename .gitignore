# Secrets / private config
.env
.env.*
!.env.example
*.key
*.pem
secrets/
ansible/inventory/private*
ansible/**/vault*
# private fleet inventory (contains local hostnames + connection vars)
ansible/inventory/hosts.yml
ansible/inventory/host_vars/

# Generated CoreDNS config (rendered from *.tmpl by scripts/fabric-stack.sh)
deploy/fabric-stack/coredns/generated/

# Runtime state
.herdr-engineering/
state/
cache/
artifacts/
*.db
*.sqlite*

# Local tooling
.DS_Store
.idea/
.vscode/
__pycache__/
node_modules/
target/
dist/
build/

# Python packaging
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.omx/

# T16 acceptance: local overrides and generated run state never enter git
tests/e2e/acceptance.local.yaml
tests/e2e/.run/

# autospec / UI gate run output (never committed)
.autospec/reports/

# share-link browser harness: downloaded duckdb-wasm binaries (never commit them)
scripts/.share-browser-cache/
tests/share-fixtures/html-parquet-duckdb/vendor/*.wasm
tests/share-fixtures/html-parquet-duckdb/vendor/*.worker.js
tests/share-fixtures/html-parquet-duckdb/vendor/extensions/
.superpowers/
